# Skopiuj do backend/.env i uzupełnij. Plik .env nie trafia do gita.

# Klucz do podpisywania sesji. Puste = klucz z pliku backend/.secret_key (tworzony automatycznie).
# Zmiana klucza wylogowuje wszystkich.
IMPAKT_SECRET_KEY=

# Konto urzędu zakładane przy starcie, jeśli jeszcze nie istnieje.
# Zmiana tutaj nie nadpisuje istniejącego konta w bazie.
IMPAKT_ADMIN_USERNAME=meow
IMPAKT_ADMIN_PASSWORD=meow_meow
